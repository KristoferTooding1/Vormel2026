PORT=3001
JOLPICA_BASE=https://api.jolpi.ca/ergast/f1

# SQLite file holding user accounts and sessions
DB_PATH=./data/vormel.db

# Comma-separated frontend origins allowed to send the login cookie
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# How long Jolpica responses are cached in memory, in seconds
CACHE_TTL_SECONDS=300
